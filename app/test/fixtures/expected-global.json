      "tag": "proxy",
      "outbounds": [
        "auto",
        "vps-reality",
        "vps-hysteria2",
        "vps-ss2022"
      ],
      "default": "auto",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "vps-reality",
        "vps-hysteria2",
        "vps-ss2022"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "60s",
      "tolerance": 50
    },
    {
      "type": "vless",
      "tag": "vps-reality",
      "server": "203.0.113.10",
      "server_port": 443,
      "uuid": "00000000-0000-0000-0000-000000000000",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "www.microsoft.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "short_id": "0123abcd"
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "vps-hysteria2",
      "server": "203.0.113.10",
      "server_port": 443,
      "password": "HY2_PLACEHOLDER",
      "tls": {
        "enabled": true,
        "server_name": "www.bing.com",
        "alpn": [
          "h3"
        ],
        "certificate_public_key_sha256": [
          "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
        ]
      }
    },
    {
      "type": "shadowsocks",
      "tag": "vps-ss2022",
      "server": "203.0.113.10",
      "server_port": 8443,
      "method": "2022-blake3-aes-128-gcm",
      "password": "AAAAAAAAAAAAAAAAAAAAAA==",
      "udp_over_tcp": true
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_version": 6,
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "alipay.com",
          "gov.cn",
          "qq.com",
          "weixin.qq.com",
          "12306.cn",
          "icbc.com.cn"
        ],
        "outbound": "direct"
      }
    ],
    "default_domain_resolver": {
      "server": "dns-direct"
    },
    "final": "proxy",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
