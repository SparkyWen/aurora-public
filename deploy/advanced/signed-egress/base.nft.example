# Template: the relay's fail-closed egress boundary, loaded by aurora-relay-agent.service.
# See docs/advanced-signed-egress.md.
#
# Install as /etc/aurora-relay/base.nft (root:aurora-relay, mode 0640) after replacing:
#   SING_BOX_UID          uid of the account sing-box runs as: `id -u aurora-node`
#   HOME_PUBLIC_PORT      the home node's public Shadowsocks port (home_public_port)
#   HOME_TAILNET_ADDRESS  the home node's address in your tailnet (home_tailnet_address)
#   HOME_TAILNET_PORT     its Shadowsocks port on that address (home_tailnet_port)
#   TAILSCALE_INTERFACE   usually tailscale0
#
# The relay agent hard-codes the names below (table inet aurora_relay, set home_ipv4).
#
# Check it with `nft -c -f base.nft` before installing. A mistake here does not fail
# loudly: the entry simply stops reaching the home node.
table inet aurora_relay
flush table inet aurora_relay
table inet aurora_relay {
  # Holds at most one address: the home IP from the newest verified lease. Each element
  # times out when its lease expires, so if the home agent stops signing, the public
  # path closes by itself instead of forwarding to a stale address.
  set home_ipv4 {
    type ipv4_addr
    flags timeout
  }
  # Everything sing-box originates must match a rule here, so a bad route rule or
  # leaked relay credentials cannot turn this machine into an open proxy.
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid SING_BOX_UID ct direction reply accept
    # REALITY's handshake target has to be a TLS 1.3 site on this machine. install.sh
    # points it at a remote site by default, which this boundary would block.
    meta skuid SING_BOX_UID oifname "lo" ip daddr 127.0.0.1 tcp dport 443 accept
    meta skuid SING_BOX_UID ip daddr @home_ipv4 tcp dport HOME_PUBLIC_PORT accept
    meta skuid SING_BOX_UID oifname "TAILSCALE_INTERFACE" ip daddr HOME_TAILNET_ADDRESS tcp dport HOME_TAILNET_PORT accept
    meta skuid SING_BOX_UID reject with icmpx type admin-prohibited
  }
}
